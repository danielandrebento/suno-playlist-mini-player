{
  "name": "Alice Mini Player",
  "short_name": "Alice Mini",
  "description": "Mini-player instalável para playlists públicas do Suno.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#142846",
  "theme_color": "#06173f",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ]
}
